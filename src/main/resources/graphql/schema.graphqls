directive @Auth on FIELD_DEFINITION

type Query {
    portfolio(username: String!): Portfolio
    users: [UserProfile]
    user(username:String!): UserProfile
    allSkills: [SkillCategory]
    me: UserProfile @Auth
}

type Mutation {
    updateUserProfile(profileInput: UserProfileInput!): UserProfile @Auth

    addProject(projectInput: ProjectInput!): Project @Auth
    updateProject(projectId: ID!, projectInput: ProjectInput!): Project @Auth
    deleteProject(projectId: ID!): Boolean @Auth

    addPublication(publicationInput: PublicationInput!): Publication @Auth
    updatePublication(publicationId: ID!, publicationInput: PublicationInput!): Publication @Auth
    deletePublication(publicationId: ID!): Boolean @Auth

    addWorkExperience(workExperienceInput: WorkExperienceInput!): WorkExperience @Auth
    updateWorkExperience(experienceId: ID!, workExperienceInput: WorkExperienceInput!): WorkExperience @Auth
    deleteWorkExperience(experienceId: ID!): Boolean @Auth

    updateUserSkills(skillIds:[ID!]!): [Skill] @Auth
    updateUserTopSkills(skillIds: [ID!]!): [Skill] @Auth
}

input UserProfileInput{
    name: String
    title: String
    seo: String
    resumeUrl: String
    profilePhoto: String
    github: String
    linkedin: String
    gAnalytics: String
}

input ProjectInput{
    name: String
    description: String
    icon: String
    liveUrl: String
    githubUrl: String
    videoUrl: String
    imageUrls: [String]
    skillIds: [ID!]
}

input PublicationInput{
    title: String
    description: String
    url: String
}

input WorkExperienceInput{
    jobTitle: String
    companyName: String
    companyLogoUrl: String
    location: String
    startDate: String
    endDate: String
    description: String
    skillIds: [ID!]
}

type Portfolio {
    userProfile: UserProfile
    apps: [Project]
    skillsData: [SkillCategory]
    publicationsData: [Publication]
    workExperienceData: [WorkExperience]
    topSkills: [Skill]
}

type UserProfile{
    username: String
    name: String
    title: String
    seo: String
    email: String
    resumeUrl: String
    profilePhoto: String
    github: String
    linkedin: String
    gAnalytics: String
}

type Project {
    id: ID!
    name: String
    description: String
    icon: String
    liveUrl: String
    githubUrl: String
    videoUrl: String
    imageUrls: [String]
    skills: [Skill]
}

type Publication {
    id: ID!
    title: String
    description: String
    url: String
}

type WorkExperience{
    id: ID!
    jobTitle: String
    companyName: String
    companyLogoUrl: String
    location: String
    startDate: String
    endDate: String
    description: String
    skills: [Skill]
}
type SkillCategory {
    id: ID!
    category: String
    items: [Skill]
}

type Skill {
    id: ID!
    name: String
    icon: String
}